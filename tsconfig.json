{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/.tsbuild",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["bun-types", "@types/chrome", "@types/node"],
    "paths": {
      "@gistwarden/domain": ["./packages/domain/mod.ts"],
      "@gistwarden/repository": ["./packages/repository/mod.ts"],
      "@gistwarden/network": ["./packages/network/mod.ts"],
      "@gistwarden/orchestrator": ["./packages/orchestrator/mod.ts"],
      "@gistwarden/ui": ["./packages/ui/mod.ts"],
      "@/extension/*": ["./apps/extension/src/extension/*"],
      "@/providers/*": ["./packages/network/src/*"],
      "@/core/*": [
        "./packages/domain/src/*",
        "./packages/repository/src/*",
        "./packages/network/src/*",
        "./packages/orchestrator/src/*",
        "./packages/ui/src/core/*"
      ],
      "@/features/sync/*": [
        "./packages/network/src/*",
        "./packages/ui/src/features/sync/*"
      ],
      "@/*": ["./packages/ui/src/*"]
    }
  },
  "exclude": ["dist", "scratch", "node_modules"],
  "references": [
    { "path": "./packages/domain" },
    { "path": "./packages/repository" },
    { "path": "./packages/network" },
    { "path": "./packages/orchestrator" },
    { "path": "./packages/ui" },
    { "path": "./apps/extension" },
    { "path": "./apps/web" },
    { "path": "./apps/worker" }
  ]
}
