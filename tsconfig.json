{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["bun-types", "@types/chrome", "@types/node"],
    "paths": {
      "@gistwarden/domain": ["./packages/domain/mod.ts"],
      "@gistwarden/repository": ["./packages/repository/mod.ts"],
      "@gistwarden/network": ["./packages/network/mod.ts"],
      "@gistwarden/orchestrator": ["./packages/orchestrator/mod.ts"],
      "@gistwarden/ui": ["./packages/ui/mod.ts"],
      "@/extension/*": ["./apps/extension/src/extension/*"],
      "@/core/*": [
        "./packages/domain/src/*",
        "./packages/repository/src/*",
        "./packages/network/src/*",
        "./packages/orchestrator/src/*",
        "./packages/ui/src/core/*"
      ],
      "@/features/*": [
        "./packages/network/src/features/*",
        "./packages/ui/src/features/*"
      ],
      "@/providers/*": ["./packages/network/src/*"],
      "@/*": ["./packages/ui/src/*"]
    }
  },
  "exclude": ["dist", "scratch", "node_modules"]
}
