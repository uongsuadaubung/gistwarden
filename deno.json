{
  "exclude": [
    "dist/",
    "scratch/"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "npm:solid-js",
    "lib": ["dom", "dom.iterable", "deno.ns"],
    "strict": true,
    "types": [
      "npm:@types/chrome@^0.1.42"
    ],
    "verbatimModuleSyntax": true
  },
  "workspace": [
    "./packages/domain",
    "./packages/repository",
    "./packages/network",
    "./packages/orchestrator",
    "./packages/ui",
    "./apps/extension",
    "./apps/web"
  ],
  "imports": {
    "@gistwarden/domain": "./packages/domain/mod.ts",
    "@gistwarden/repository": "./packages/repository/mod.ts",
    "@gistwarden/network": "./packages/network/mod.ts",
    "@gistwarden/orchestrator": "./packages/orchestrator/mod.ts",
    "@gistwarden/ui": "./packages/ui/mod.ts",
    "@/extension/": "./apps/extension/src/extension/",
    "@/*": "./packages/ui/src/*",
    "@/": "./packages/ui/src/",
    "@/core/crypto.ts": "./packages/domain/src/crypto.ts",
    "@/features/sync/github-api.ts": "./packages/network/src/github-api.ts",
    "@/core/i18n.ts": "./packages/domain/src/i18n.ts",
    "@/core/totp-utils.ts": "./packages/domain/src/totp-utils.ts",
    "@/core/session-manager.ts": "./packages/domain/src/session-manager.ts",
    "@/core/session-signal.ts": "./packages/ui/src/core/session-signal.ts",
    "@/core/types.ts": "./packages/domain/src/types.ts",
    "@/core/constants.ts": "./packages/domain/src/constants.ts",
    "@/core/generator-utils.ts": "./packages/domain/src/generator-utils.ts",
    "@/core/domain-utils.ts": "./packages/domain/src/domain-utils.ts",
    "@/core/cbor-utils.ts": "./packages/domain/src/cbor-utils.ts",
    "@/core/wordlist.ts": "./packages/domain/src/wordlist.ts",
    "@/core/csv-parser.ts": "./packages/domain/src/csv-parser.ts",
    "@/core/json-utils.ts": "./packages/domain/src/json-utils.ts",
    "@/core/logger.ts": "./packages/domain/src/logger.ts",
    "@/core/storage.ts": "./packages/repository/src/storage.ts",
    "@/core/storage-schemas.ts": "./packages/repository/src/storage-schemas.ts",
    "@/core/fetch-utils.ts": "./packages/network/src/fetch-utils.ts",
    "@/providers/": "./packages/network/src/",
    "@/core/session-usecases.ts": "./packages/orchestrator/src/session-usecases.ts",
    "@/core/app-init.ts": "./packages/ui/src/core/app-init.ts",
    "@/core/messaging.ts": "./packages/orchestrator/src/messaging.ts",
    "@/core/messaging-contracts.ts": "./packages/orchestrator/src/messaging-contracts.ts",
    "@/core/alarms.ts": "./packages/orchestrator/src/alarms.ts",
    "@/core/idle.ts": "./packages/orchestrator/src/idle.ts",
    "@/core/ui-service.ts": "./packages/ui/src/core/ui-service.ts",

    "@solidjs/router": "npm:@solidjs/router@^1.0.0",
    "consola": "npm:consola@^3.4.2",
    "fs": "node:fs",
    "hash-wasm": "npm:hash-wasm@^4.12.0",
    "jsdom": "npm:jsdom@^29.1.1",
    "neverthrow": "npm:neverthrow@^8.2.0",
    "zxcvbn": "npm:@zxcvbn-ts/core@^4.1.2",
    "path": "node:path",
    "solid-js": "npm:solid-js@^1.9.14",
    "solid-js/web": "npm:solid-js@^1.9.14/web",
    "esbuild": "npm:esbuild@^0.28.1",
    "esbuild-plugin-solid": "npm:esbuild-plugin-solid@^0.6.0",
    "sass": "npm:sass@^1.102.0",
    "adm-zip": "npm:adm-zip@^0.6.0",
    "tldts": "npm:tldts@^7.4.9",
    "zod": "npm:zod@^4.4.3",
    "otpauth": "npm:otpauth@^9.5.1",
    "qrcode-parser": "npm:qrcode-parser@^2.1.3",
    "@std/assert": "jsr:@std/assert@1",
    "papaparse": "npm:papaparse@^5.5.4"
  },
  "tasks": {
    "audit-functions": "deno run --allow-read --allow-write scripts/audit_functions.ts",
    "build-extension": "deno run --node-modules-dir=auto -A ./apps/extension/build.ts",
    "build-web": "deno run --node-modules-dir=auto -A ./apps/web/build.ts",
    "build": "deno task build-extension && deno task build-web",
    "watch": "deno run --node-modules-dir=auto -A ./apps/extension/build.ts --watch",
    "test": "deno test -A",
    "test-server": "deno run -A web_test_login/server.ts",
    "bump-version": "deno run -A version.ts"
  },

  "fmt": {
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "plugins": [
      "./custom-rules-plugin.ts"
    ],
    "rules": {
      "tags": [
        "recommended",
        "jsx"
      ],
      "include": [
        "no-explicit-any",
        "no-eval",
        "no-async-promise-executor",
        "prefer-const",
        "no-sparse-arrays"
      ],
      "exclude": [
        "no-window",
        "no-window-prefix",
        "jsx-boolean-value",
        "jsx-button-has-type"
      ]
    }
  }
}
