{
  "name": "gistwarden",
  "version": "1.0.0",
  "description": "Gistwarden - Encrypted Password & Vault Manager",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts dev",
    "build:dev": "bun run scripts/build.ts dev",
    "build:extension": "bun run scripts/build.ts extension",
    "build:web": "bun run scripts/build.ts web",
    "build:all": "bun run scripts/build.ts all",
    "build:wasm": "cargo build --manifest-path crates/gistwarden-wasm/Cargo.toml --target wasm32-unknown-unknown --release && wasm-bindgen crates/gistwarden-wasm/target/wasm32-unknown-unknown/release/gistwarden_wasm.wasm --out-dir packages/domain/src/wasm/generated --target web && bun run scripts/embed_wasm.ts",
    "check:wasm": "cargo check --manifest-path crates/gistwarden-wasm/Cargo.toml --target wasm32-unknown-unknown",
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit",
    "lint": "bun run scripts/custom_linter.ts",
    "bump-version": "bun run version.ts"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "happy-dom": "^20.11.1",
    "lucide-solid": "^1.28.0",
    "neverthrow": "^8.2.0",
    "solid-js": "^1.9.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "bun-plugin-solid": "^1.0.0",
    "bun-types": "^1.3.14",
    "esbuild": "^0.28.1",
    "esbuild-plugin-solid": "^0.6.0",
    "typescript": "^7.0.2"
  }
}
