{
  "name": "gistwarden",
  "version": "1.0.0",
  "description": "Gistwarden - Encrypted Password & Vault Manager",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts dev",
    "build:extension": "bun run scripts/build.ts extension",
    "build:web": "bun run scripts/build.ts web",
    "build:all": "bun run scripts/build.ts all",
    "serve": "bun run scripts/serve.ts",
    "test": "bun test tests/",
    "typecheck": "tsc -b",
    "lint": "bun run scripts/custom_linter.ts",
    "biome:check": "biome check .",
    "biome:format": "biome format --write .",
    "biome:lint": "biome lint .",
    "build:readme": "bun run scripts/generate_readme.ts",
    "bump-version": "bun run version.ts",
    "worker:dev": "wrangler dev --config apps/worker/wrangler.json",
    "worker:deploy": "wrangler deploy --config apps/worker/wrangler.json",
    "worker:d1:init:local": "wrangler d1 execute gistwarden-db --local --file=apps/worker/migrations/0000_init.sql --config apps/worker/wrangler.json",
    "worker:d1:init:remote": "wrangler d1 execute gistwarden-db --remote --file=apps/worker/migrations/0000_init.sql --config apps/worker/wrangler.json"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "consola": "^3.4.2",
    "esbuild": "^0.28.2",
    "esbuild-plugin-solid": "^0.6.0",
    "fflate": "^0.8.3",
    "happy-dom": "^20.11.15",
    "hash-wasm": "^4.12.0",
    "hono": "^4.7.0",
    "lucide-solid": "^1.37.0",
    "neverthrow": "^8.2.0",
    "otpauth": "^9.5.1",
    "papaparse": "^5.7.0",
    "qrcode-parser": "^2.1.3",
    "solid-js": "^1.9.15",
    "tldts": "^7.4.11",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.4.0",
    "@types/papaparse": "^5.5.2",
    "bun-plugin-solid": "^1.0.0",
    "bun-types": "^1.4.0",
    "typescript": "^7.0.2",
    "wrangler": "^3.114.0"
  }
}
