{
  "name": "gistwarden",
  "version": "1.0.0",
  "description": "Gistwarden - Encrypted Password & Vault Manager",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts dev",
    "build:extension": "bun run scripts/build.ts extension",
    "build:web": "bun run scripts/build.ts web",
    "build:all": "bun run scripts/build.ts all",
    "serve": "bun run scripts/serve.ts",
    "test": "bun test --conditions browser tests/",
    "typecheck": "tsc -b",
    "lint": "bun run scripts/custom_linter.ts",
    "biome:check": "biome check .",
    "biome:format": "biome format --write .",
    "biome:lint": "biome lint .",
    "build:readme": "bun run scripts/generate_readme.ts",
    "bump-version": "bun run version.ts"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "consola": "^3.4.2",
    "esbuild": "^0.28.2",
    "esbuild-plugin-solid": "^0.6.0",
    "fflate": "^0.8.3",
    "happy-dom": "^20.11.6",
    "hash-wasm": "^4.12.0",
    "lucide-solid": "^1.33.0",
    "neverthrow": "^8.2.0",
    "otpauth": "^9.5.1",
    "papaparse": "^5.6.0",
    "qrcode-parser": "^2.1.3",
    "solid-js": "^1.9.15",
    "tldts": "^7.4.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/user-event": "^14.6.6",
    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "@types/papaparse": "^5.5.2",
    "bun-plugin-solid": "^1.0.0",
    "bun-types": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
