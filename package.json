    "papaparse": "^5.5.4",
    "qrcode-parser": "^2.1.3",
    "solid-js": "^1.9.14",
    "tldts": "^7.4.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "@types/papaparse": "^5.5.2",
